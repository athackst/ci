{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "copier copy",
            "type": "shell",
            "command": "copier copy --trust --vcs-ref HEAD . .",
            "problemMatcher": []
        },
        {
            "label": "test actions",
            "type": "shell",
            "command": "pytest -v actions",
            "problemMatcher": []
        },
        {
            "label": "test workflows",
            "type": "shell",
            "command": "python3 -m unittest discover -s tests/workflows -p 'test_*.py' -v",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": []
        }
    ]
}
